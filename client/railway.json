{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build --workspace=project-management"
  },
  "deploy": {
    "startCommand": "node client/prod-server.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
} 
