{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "npx serve -s dist -l $PORT --host 0.0.0.0",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
