{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "installCommand": "npm install --include-workspace-root",
    "buildCommand": "npm run build --workspace=project-management"
  },
  "deploy": {
    "startCommand": "node prod-server.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
} 
