{
  "name": "taskflow-root",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install-all": "npm install && npm install --prefix client && npm install --prefix server",
